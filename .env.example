# Hosted server (M2+). Local Preview (`collab <path>`) needs none of this.

# Postgres (Drizzle). Host port 5544 matches docker-compose (avoids clashing with
# a host-managed Postgres on 5432). 127.0.0.1 sidesteps IPv6 (::1) resolution.
DATABASE_URL=postgres://collab:collab@127.0.0.1:5544/collab

# Object storage (S3-compatible; MinIO locally, R2/S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=collab-blobs
S3_ACCESS_KEY_ID=collab
S3_SECRET_ACCESS_KEY=collab-secret
# MinIO and other non-AWS S3 implementations need path-style addressing.
S3_FORCE_PATH_STYLE=true

# REST API / content-origin server
PORT=8787
# Public base URL of this server — used to build content-origin (iframe) URLs.
PUBLIC_URL=http://localhost:8787
# Base URL of the viewer SPA — used to build Share URLs handed to reviewers.
VIEWER_URL=http://localhost:5173

# ---- M10: GitHub integration (operator-only, all optional — off when unset) ----
# Register a GitHub App (https://github.com/settings/apps/new) with these permissions:
#   Repository > Pull requests: Read & write
#   Repository > Contents: Read-only
#   Subscribe to events: Pull request review comments, Issue comments, Pull request reviews
#
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=collab
# GITHUB_APP_PRIVATE_KEY=<PEM value, or set GITHUB_APP_PRIVATE_KEY_PATH instead>
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/app-private-key.pem
# GITHUB_WEBHOOK_SECRET=<random string matching the App's webhook secret>
# GITHUB_API_BASE=https://api.github.com
# GITHUB_RECONCILE_INTERVAL_MS=60000

# ---- M11: deployment-agnostic server (ADR-0015, all optional) ----
# Rate limiter backing store. Default `memory` (in-process, fine for
# single-instance self-host). Set `postgres` for any multi-instance deployment
# — the Vercel adapter forces this regardless of what's set here.
# COLLAB_RATELIMIT_STORE=memory
#
# Bearer secret gating POST/GET /internal/drain, the platform-agnostic trigger
# for the outbound mirror-bus drain + inbound reconcile sweep. Self-host runs
# this from its own setInterval and never needs the route — leave unset (the
# route 404s). Required on Vercel, where Vercel Cron calls the route instead;
# set it to the same value as Vercel's auto-generated CRON_SECRET so Vercel's
# Cron-request `Authorization: Bearer $CRON_SECRET` header authenticates. See
# docs/deploy-vercel.md.
# COLLAB_INTERNAL_SECRET=<random string, matching Vercel's CRON_SECRET on Vercel>
#
# See docs/deploy-vercel.md for the full Vercel deployment reference.
