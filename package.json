{
  "name": "scholia-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @scholia/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:no-db": "vitest run packages/core packages/cli packages/local packages/bridge packages/github",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:generate": "pnpm --filter @scholia/db generate",
    "db:migrate": "pnpm --filter @scholia/db migrate",
    "dev:server": "pnpm --filter @scholia/server dev",
    "dev:web": "pnpm --filter @scholia/web dev",
    "scholia": "tsx packages/cli/src/cli.ts",
    "prototype:localhost-origin": "node packages/local/prototype/localhost-origin-probe/server.mjs",
    "e2e": "pnpm --filter @scholia/e2e test",
    "e2e:install": "pnpm --filter @scholia/e2e install:browsers",
    "changeset": "changeset",
    "release": "pnpm --filter scholia build && pnpm changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.12",
    "@types/node": "^22.10.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0"
}
