{
  "name": "scholia",
  "version": "0.1.2",
  "description": "Preview a local markdown file or folder in your browser. One command, no config, no account, no network.",
  "keywords": [
    "cli",
    "docs",
    "katex",
    "live-reload",
    "markdown",
    "mdx",
    "mermaid",
    "preview"
  ],
  "homepage": "https://github.com/jtmthf/scholia#readme",
  "bugs": "https://github.com/jtmthf/scholia/issues",
  "license": "MIT",
  "author": "Jack Moore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtmthf/scholia.git",
    "directory": "packages/cli"
  },
  "bin": {
    "scholia": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "pnpm --filter @scholia/local build && tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@scholia/client": "workspace:*",
    "@scholia/core": "workspace:*",
    "@scholia/local": "workspace:*",
    "@scholia/sidecar": "workspace:*",
    "fflate": "^0.8.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=22"
  }
}
