    "@collab/local": "workspace:*",
    "cac": "^7.0.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "fflate": "^0.8.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2"
  }
}
