{
  "name": "@jtmthf/collab",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "collab": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
