{
  "name": "@scholia/local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@scholia/bridge": "workspace:*",
    "@scholia/core": "workspace:*",
    "@scholia/sidecar": "workspace:*",
    "@scholia/theme": "workspace:*",
    "@scholia/ui": "workspace:*",
    "chokidar": "^5.0.0",
    "hono": "^4.12.26",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@scholia/tsconfig": "workspace:*",
    "@scholia/vitest-config": "workspace:*",
    "parse5": "^7.2.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.10"
  }
