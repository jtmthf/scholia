{
  "name": "@scholia/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@hono/standard-validator": "^0.2.3",
    "@scholia/bridge": "workspace:*",
    "@scholia/core": "workspace:*",
    "@scholia/db": "workspace:*",
    "@scholia/github": "workspace:*",
    "hono": "^4.12.26",
    "hono-openapi": "^1.3.1"
  },
  "devDependencies": {
    "@scholia/client": "workspace:*",
    "@scholia/tsconfig": "workspace:*",
    "@scholia/vitest-config": "workspace:*",
    "drizzle-orm": "^0.38.2",
    "postgres": "^3.4.5",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
}
