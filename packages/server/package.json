{
  "name": "@scholia/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@hono/standard-validator": "^0.2.3",
    "@scholia/bridge": "workspace:*",
    "@scholia/core": "workspace:*",
    "@scholia/db": "workspace:*",
    "@scholia/github": "workspace:*",
    "hono": "^4.12.26",
    "hono-openapi": "^1.3.1"
  },
  "devDependencies": {
    "drizzle-orm": "^0.38.2",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2"
  }
}
