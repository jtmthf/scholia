{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // *.d.ts is the `typecheck` task's output (see below) — excluded here
      // so a cache restore of one never clobbers the other, regardless of
      // which ran last.
      "outputs": ["dist/**", "!dist/**/*.d.ts", "!dist/**/*.d.ts.map"]
    },
    "typecheck": {
      // Cross-package type errors surface through a dependency's dist/*.d.ts.
      // `typecheck` is what emits those (not `build`) — tsup's own dts
      // generation doesn't work under TypeScript 7 yet, since it needs the
      // programmatic compiler API, targeted for 7.1, not 7.0 (ADR-0025).
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    },
    "test": {
      // Runtime imports of workspace deps (and, for @scholia/core's own
      // tests, of itself) resolve through package.json main/exports to
      // dist/*.js, so tests need both the dependency graph and the
      // package's own build.
      "dependsOn": ["^build", "build"],
      // @scholia/db and @scholia/server read this for the isolated-Postgres
      // globalSetup (see AGENTS.md's "Running the hosted-path tests").
      "env": ["DATABASE_URL"]
    },
    "scholia": {
      "dependsOn": ["^build"],
      "cache": false,
      // Strict envMode (the default) hides everything not declared here from
      // the CLI process. SCHOLIA_HOSTED gates whether hosted commands (e.g.
      // `share`) register at all; the rest are the env fallbacks `cli.ts`
      // reads for options a caller can also pass as flags.
      "env": ["SCHOLIA_HOSTED", "SCHOLIA_SERVER", "SCHOLIA_SITE", "SCHOLIA_TOKEN", "SCHOLIA_VIEWER"]
    },
    // Package overrides don't inherit unspecified fields from the base task
    // above, so every override below restates `dependsOn` even where the
    // value is unchanged.
    "@scholia/theme#build": {
      "dependsOn": ["^build"],
      "outputs": ["fonts/**"]
    },
    // Neither is imported by another workspace package, so `typecheck` here
    // is pure checking — no dist/*.d.ts to declare as output.
    "scholia#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@scholia/web#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
